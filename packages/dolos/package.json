{
  "name": "cardano-tessera-dolos",
  "version": "0.0.0",
  "description": "Tessera's verifier inputs read from the queries of two Dolos nodes instead of Koios, and the command that builds those nodes from Mithril.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "nodes": "tsx src/nodesCli.ts",
    "type-check": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "cardano-tessera-client": "workspace:*",
    "cardano-tessera-koios": "workspace:*",
    "cip-179": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
