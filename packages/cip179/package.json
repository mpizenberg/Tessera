{
  "name": "cip-179",
  "version": "0.2.0",
  "description": "Reusable TypeScript building blocks for CIP-179 on-chain surveys and polls (label 17): the metadatum codec, pure domain semantics, the reproducible tally artifact, transaction-proof decoding, and the sealed-submission tlock stack.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./domain": {
      "types": "./src/domain/index.ts",
      "import": "./src/domain/index.ts"
    },
    "./tally": {
      "types": "./src/tally/index.ts",
      "import": "./src/tally/index.ts"
    },
    "./txproof": {
      "types": "./src/txproof/index.ts",
      "import": "./src/txproof/index.ts"
    },
    "./tlock": {
      "types": "./src/tlock/index.ts",
      "import": "./src/tlock/index.ts"
    },
    "./evolution": {
      "types": "./src/evolution/index.ts",
      "import": "./src/evolution/index.ts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./domain": {
        "types": "./dist/domain/index.d.ts",
        "import": "./dist/domain/index.js"
      },
      "./tally": {
        "types": "./dist/tally/index.d.ts",
        "import": "./dist/tally/index.js"
      },
      "./txproof": {
        "types": "./dist/txproof/index.d.ts",
        "import": "./dist/txproof/index.js"
      },
      "./tlock": {
        "types": "./dist/tlock/index.d.ts",
        "import": "./dist/tlock/index.js"
      },
      "./evolution": {
        "types": "./dist/evolution/index.d.ts",
        "import": "./dist/evolution/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "cardano",
    "cip-179",
    "cip-0179",
    "survey",
    "poll",
    "metadata",
    "governance"
  ],
  "dependencies": {
    "@noble/hashes": "^2.2.0"
  },
  "peerDependencies": {
    "@evolution-sdk/evolution": "^0.5.9",
    "@mattpiz/tlock-js": "0.10.0"
  },
  "peerDependenciesMeta": {
    "@evolution-sdk/evolution": {
      "optional": true
    },
    "@mattpiz/tlock-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@evolution-sdk/evolution": "^0.5.9",
    "@mattpiz/tlock-js": "0.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
