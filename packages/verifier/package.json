{
  "name": "cardano-tessera-verifier",
  "version": "0.1.0",
  "description": "Standalone re-verifier for Tessera tally artifacts: refetches every input from Koios or from two Dolos nodes, re-runs the tally, and compares content hashes. Takes only the artifact under test from the backend.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "exports": {
    ".": {
      "types": "./src/verify.ts",
      "import": "./src/verify.ts"
    }
  },
  "scripts": {
    "verify": "tsx src/cli.ts",
    "type-check": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@evolution-sdk/evolution": "^0.5.14",
    "@mattpiz/tlock-js": "0.10.0",
    "cardano-tessera-amaru": "workspace:*",
    "cardano-tessera-client": "workspace:*",
    "cardano-tessera-core": "workspace:*",
    "cardano-tessera-dolos": "workspace:*",
    "cardano-tessera-koios": "workspace:*",
    "cip-179": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9"
  }
}
