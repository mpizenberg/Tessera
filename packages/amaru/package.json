{
  "name": "cardano-tessera-amaru",
  "version": "0.0.0",
  "description": "Tessera's verifier inputs read from what amaru-store-reader printed out of an Amaru node's stores instead of Koios, and the command that builds those stores from PRAGMA's states and Mithril.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build-stores": "tsx src/buildCli.ts",
    "type-check": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "cardano-tessera-client": "workspace:*",
    "cardano-tessera-koios": "workspace:*",
    "cip-179": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^2.1.9"
  }
}
