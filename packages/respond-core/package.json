{
  "name": "@tessera/respond-core",
  "version": "0.1.0",
  "description": "Pure, framework-free core for answering CIP-179 surveys: response drafting, role/credential derivation, and eligibility (including host-trusted SPO/CC credentials). Consumed by the Tessera app and the embeddable <tessera-respond> widget. No I/O, no framework.",
  "type": "module",
  "private": true,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "type-check": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "cip-179": "workspace:*"
  },
  "peerDependencies": {
    "@evolution-sdk/evolution": "^0.5.9",
    "@mattpiz/tlock-js": "0.10.0"
  },
  "peerDependenciesMeta": {
    "@evolution-sdk/evolution": {
      "optional": true
    },
    "@mattpiz/tlock-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@evolution-sdk/evolution": "^0.5.9",
    "@mattpiz/tlock-js": "0.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
