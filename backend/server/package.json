{
  "name": "cardano-tessera-backend",
  "version": "0.1.0",
  "description": "Tessera Tier-1 serving backend: the Koios read-path snapshot, cached in SQLite and served over HTTP. Runs as a local Node process now; the same Hono app + a D1 adapter target Cloudflare Workers later.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:preview": "NETWORK=preview tsx watch src/main.ts",
    "dev:preprod": "NETWORK=preprod tsx watch src/main.ts",
    "dev:mainnet": "NETWORK=mainnet tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "dev:cf": "wrangler dev --env preview --test-scheduled",
    "migrate:preprod": "wrangler d1 migrations apply DB --env preprod --remote",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:preprod": "wrangler deploy --env preprod",
    "deploy:mainnet": "wrangler deploy --env mainnet",
    "type-check": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "cardano-tessera-core": "workspace:*",
    "cardano-tessera-koios": "workspace:*",
    "cip-179": "workspace:*",
    "@evolution-sdk/evolution": "^0.5.9",
    "@mattpiz/tlock-js": "0.10.0",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "cardano-tessera-verifier": "workspace:*",
    "@types/node": "^25.9.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
