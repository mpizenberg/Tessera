{
  "name": "cardano-tessera-backend",
  "version": "0.1.0",
  "description": "Tessera Tier-1 serving backend: the Koios read-path snapshot, cached in SQLite and served over HTTP.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:preview": "NETWORK=preview tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:preprod": "NETWORK=preprod tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:mainnet": "NETWORK=mainnet tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "build:vercel": "tsx src/vercel-output.ts",
    "type-check": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@evolution-sdk/evolution": "^0.5.16",
    "@hono/node-server": "^2.1.1",
    "@libsql/client": "^0.18.0",
    "@mattpiz/tlock-js": "0.10.0",
    "cardano-tessera-client": "workspace:*",
    "cardano-tessera-core": "workspace:*",
    "cardano-tessera-koios": "workspace:*",
    "cip-179": "workspace:*",
    "hono": "^4.13.9"
  },
  "devDependencies": {
    "@types/node": "^25.9.8",
    "cardano-tessera-verifier": "workspace:*",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
