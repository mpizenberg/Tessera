# Cloudflare deployment of the Tier-1 backend (src/worker.ts).
#
# Copy to `wrangler.toml` (git-ignored) and fill in the D1 database ids of the
# networks you deploy; leave the rest at the placeholder. The ids identify
# resources in one Cloudflare account, so they are operator state rather than
# portable source — see OPERATIONS.md for creating a database and recovering an
# existing id. Everything else here is project configuration: change it in this
# template, then re-copy, so the two never drift.
#
# Preview, preprod, and mainnet are explicit Wrangler environments with
# separate D1 databases and vars — three deployments of one Worker, no network
# path segment (ARCHITECTURE.md §11). The top-level preview values remain as a
# safe fallback, but project commands always select an environment.

# Naming rule across the project: the network is always an explicit suffix
# (tessera-{preview,preprod,mainnet} for the app,
# tessera-backend-{preview,preprod,mainnet} here) — bare pretty names are a
# custom domain's job, not the workers'.
name = "tessera-backend-preview"
main = "src/worker.ts"
compatibility_date = "2026-06-01"
compatibility_flags = ["nodejs_compat"]

[triggers]
# ≈ the Node entry's 180 s REFRESH_SECONDS default (cron floor is 1 minute).
crons = ["*/3 * * * *"]

# The CPU a refresh may spend, stated because finalize.ts derives its sealed
# decrypt budget from it. A cron under an hour apart gets 30 s on the paid plan
# whatever this says (the 5-minute maximum is for HTTP requests), so this pins
# the fetch path to the same ceiling rather than raising the cron's. The free
# plan caps both at 10 ms — less than one timelock decrypt, so sealed surveys
# cannot be revealed there at all.
[limits]
cpu_ms = 30000

[vars]
NETWORK = "preview"

[[d1_databases]]
binding = "DB"
database_name = "tessera-cache-preview"
database_id = "00000000-0000-0000-0000-000000000000"
migrations_dir = "migrations"

# Environments inherit [triggers] and [limits] but not [vars] or bindings —
# those are redeclared below. Preprod also repeats its CPU limit so the
# deployment-critical sealed-reveal budget is visible in its complete block.
[env.preview]
name = "tessera-backend-preview"
[env.preview.vars]
NETWORK = "preview"

[[env.preview.d1_databases]]
binding = "DB"
database_name = "tessera-cache-preview"
database_id = "00000000-0000-0000-0000-000000000000"
migrations_dir = "migrations"

[env.preprod]
name = "tessera-backend-preprod"

[env.preprod.limits]
cpu_ms = 30000

[env.preprod.vars]
NETWORK = "preprod"

[[env.preprod.d1_databases]]
binding = "DB"
database_name = "tessera-cache-preprod"
database_id = "00000000-0000-0000-0000-000000000000"
migrations_dir = "migrations"

[env.mainnet]
name = "tessera-backend-mainnet"
[env.mainnet.vars]
NETWORK = "mainnet"

[[env.mainnet.d1_databases]]
binding = "DB"
database_name = "tessera-cache-mainnet"
database_id = "00000000-0000-0000-0000-000000000000"
migrations_dir = "migrations"
