# Tessera backend — all values are optional; sane defaults let it run with none.
# Copy to `.env` to override.

# Network to index: mainnet | preprod | preview. Default: preview.
NETWORK=preview

# Koios REST base URL. Default: derived from NETWORK.
# KOIOS_URL=https://preview.koios.rest/api/v1

# Koios bearer token for the CRITICAL path — snapshot refresh, response
# validation, artifact finalization — and the short-cached tip/pparams
# passthroughs. Server-side fetch is NOT CORS-bound, so the anonymous tier works
# with no token; set one only for rate headroom.
# KOIOS_TOKEN=

# SEPARATE Koios token for the /api/tx_status comfort passthrough (uncached,
# frontend-driven confirmation polling). Kept distinct so a flood of that public
# endpoint can only exhaust THIS quota, never the KOIOS_TOKEN quota the
# refresh/validate/finalize path needs for artifact correctness.
# Default: UNSET = unauthenticated — a separate per-IP Koios bucket. It does NOT
# fall back to KOIOS_TOKEN. Set only to give comfort traffic its own keyed tier.
# KOIOS_PASSTHROUGH_TOKEN=

# Only index CIP-179 txs at/after this ISO date. Default: 2026-06-01T00:00:00Z.
# SINCE=2026-06-01T00:00:00Z

# HTTP port. Default: 8787.
PORT=8787

# Snapshot refresh interval, seconds. Default: 180.
REFRESH_SECONDS=180

# SQLite cache file. Default: ./tessera-cache-$NETWORK.sqlite — one file per
# network, since the cache stores no network of its own. Use :memory: for none.
# DB_PATH=./tessera-cache-preview.sqlite
