# Deployment values baked into app builds (`vite build --mode <network>`).
# Copy to `.env.deploy` (git-ignored) and fill in your deployments; variables
# already set in the environment take precedence over this file. A build
# requires its own network's two variables to be declared — empty is a valid,
# explicit "none". Dev servers never read this file.

# Tier-1 backend each network's app reads from. Empty ⇒ direct Koios (the app
# then needs a Koios token pasted in Settings).
TESSERA_BACKEND_URL_PREVIEW=https://tessera-backend-preview.matthieu-pizenberg.workers.dev
TESSERA_BACKEND_URL_PREPROD=
TESSERA_BACKEND_URL_MAINNET=

# Where each network's app is served — the header cross-links (self filtered
# out at runtime). Empty ⇒ no link; add one when that network first deploys,
# then redeploy the others so their headers pick it up.
TESSERA_APP_URL_PREVIEW=https://tessera-preview.matthieu-pizenberg.workers.dev
TESSERA_APP_URL_PREPROD=
TESSERA_APP_URL_MAINNET=
