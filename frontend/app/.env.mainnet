# Baked into the deployed MAINNET build by `pnpm deploy:mainnet` (Vite mode
# "mainnet"). Committed on purpose: everything here is public configuration —
# VITE_* values end up in the shipped bundle regardless.
VITE_NETWORK=mainnet

# The mainnet backend is not deployed yet — set this when it is (see
# backend/server/README.md, `--env mainnet` steps) before deploying this app.
# Until set, the mainnet app would fall back to direct Koios (token required).
# VITE_INDEXER_URL=https://tessera-backend-mainnet.matthieu-pizenberg.workers.dev

# Cross-links to deployed testnet apps.
# VITE_PREPROD_URL=https://tessera-preprod.matthieu-pizenberg.workers.dev
VITE_PREVIEW_URL=https://tessera-preview.matthieu-pizenberg.workers.dev
