# Copy to `.env` and fill in.

# The network this deployment serves: "mainnet", "preprod", or "preview"
# (default). One deployment serves exactly one network — there is no runtime
# switch.
# VITE_NETWORK=preview

# Other deployed network builds to link from the header and Settings. All are
# optional; the active network's URL is ignored.
# VITE_MAINNET_URL=https://tessera-mainnet.example.org
# VITE_PREPROD_URL=https://tessera-preprod.example.org
# VITE_PREVIEW_URL=https://tessera-preview.example.org

# Tier-1 serving backend URL for this network. When set, the app both reads its
# snapshot from this backend and builds transactions from its protocol
# parameters — so no Koios token is needed at all (transactions are still
# signed by your wallet). It must serve the same network as VITE_NETWORK; the
# app verifies this against the backend's /health. Leave it unset to use Koios
# directly instead (the power-user/offline path), which then needs a Koios
# token pasted in the app's Settings. For local development against
# `@tessera/backend` (`pnpm --filter @tessera/backend dev`):
# VITE_INDEXER_URL=http://localhost:8787

# IPFS reads race a built-in list of public gateways (no config). IPFS *pinning*
# (authoring external content / rationales) uses per-provider API tokens entered
# in Settings (Pinata / Blockfrost / NMKR), stored only in the browser.
