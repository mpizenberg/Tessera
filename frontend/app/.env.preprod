# Baked into a PREPROD build by Vite mode "preprod". Committed on purpose:
# every VITE_* value is public configuration shipped in the bundle.
VITE_NETWORK=preprod

# Set after the dedicated preprod backend is deployed. Until then, this build
# uses direct Koios and needs a token entered in Settings.
# VITE_INDEXER_URL=https://tessera-backend-preprod.matthieu-pizenberg.workers.dev

# Cross-links to deployed network apps.
# VITE_MAINNET_URL=https://tessera-mainnet.matthieu-pizenberg.workers.dev
VITE_PREVIEW_URL=https://tessera-preview.matthieu-pizenberg.workers.dev
