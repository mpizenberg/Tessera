{
  "name": "tessera-app",
  "version": "0.1.0",
  "description": "Tessera — CIP-179 on-chain surveys & polls frontend (SolidJS)",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "dev:preprod": "vite --mode preprod",
    "build": "vite build --mode preview",
    "preview": "vite preview --mode preview",
    "deploy:preview": "vite build --mode preview && wrangler deploy --env preview",
    "deploy:preprod": "vite build --mode preprod && wrangler deploy --env preprod",
    "deploy:mainnet": "vite build --mode mainnet && wrangler deploy --env mainnet",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@evolution-sdk/evolution": "^0.5.14",
    "@mattpiz/tlock-js": "0.10.0",
    "@noble/hashes": "^2.4.0",
    "@solidjs/router": "^0.16.3",
    "cardano-tessera-client": "workspace:*",
    "cardano-tessera-core": "workspace:*",
    "cardano-tessera-koios": "workspace:*",
    "cardano-tessera-respond": "workspace:*",
    "cardano-tessera-respond-core": "workspace:*",
    "cardano-tessera-respond-ui": "workspace:*",
    "cip-179": "workspace:*",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@types/node": "^25.9.8",
    "solid-element": "^1.9.2",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^2.1.9",
    "wrangler": "^4.138.0"
  }
}
