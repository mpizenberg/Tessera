{
  "name": "tessera-app",
  "version": "0.1.0",
  "description": "Tessera — CIP-179 on-chain surveys & polls frontend (SolidJS)",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:preview": "vite build --mode preview && wrangler deploy",
    "deploy:mainnet": "vite build --mode mainnet && wrangler deploy --env mainnet",
    "type-check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@evolution-sdk/evolution": "^0.5.9",
    "@mattpiz/tlock-js": "0.10.0",
    "@noble/hashes": "^2.2.0",
    "@solidjs/router": "^0.16.1",
    "@tessera/core": "workspace:*",
    "@tessera/koios": "workspace:*",
    "@tessera/respond-core": "workspace:*",
    "@tessera/respond-widget": "workspace:*",
    "cip-179": "workspace:*",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "solid-element": "^1.9.2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
