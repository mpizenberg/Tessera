# Baked into the deployed PREVIEW build by `pnpm deploy:preview` (Vite mode
# "preview"). Committed on purpose: everything here is public configuration —
# VITE_* values end up in the shipped bundle regardless.
VITE_NETWORK=preview
VITE_INDEXER_URL=https://tessera-backend-preview.matthieu-pizenberg.workers.dev

# Cross-link to the mainnet app — set once it is deployed, then redeploy.
# VITE_OTHER_NETWORK_URL=https://tessera-mainnet.matthieu-pizenberg.workers.dev

# Deliberately blank: a token in a developer's local .env (loaded in every Vite
# mode) must never leak into a deployed bundle.
VITE_KOIOS_TOKEN=
